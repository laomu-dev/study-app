
# 服务器配置
PORT=3001
NODE_ENV=production

# 会话密钥（请使用随机字符串）
SESSION_SECRET=change-this-to-a-random-secret-key-please

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=study_app
DB_PASSWORD=your_password_here
DB_NAME=study_app

# OpenAI 兼容接口（阿里云百炼、DeepSeek、硅基流动等）
AI_API_KEY=your-compatible-api-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# OpenAI 备用配置
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_EXPLANATION_MODEL=gpt-4.1-mini
MATERIAL_SOURCE_MAX_CHARS=60000
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
